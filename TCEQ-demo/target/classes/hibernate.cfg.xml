<?xml version="1.0" encoding="UTF-8"?>
<!--
    Hibernate XML Configuration File
    Demonstrates knowledge of traditional (pre-annotation) Hibernate configuration.
    In this project, Spring Boot auto-configures Hibernate via application.properties,
    but this file is included as a portfolio reference for legacy system support.
-->
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings (Oracle-compatible) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:tceqdb;MODE=Oracle</property>
        <property name="hibernate.connection.username">tceq_admin</property>
        <property name="hibernate.connection.password">tceq_pass</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Connection pool (C3P0) -->
        <property name="hibernate.c3p0.min_size">5</property>
        <property name="hibernate.c3p0.max_size">20</property>
        <property name="hibernate.c3p0.timeout">300</property>
        <property name="hibernate.c3p0.max_statements">50</property>
        <property name="hibernate.c3p0.idle_test_period">3000</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.use_sql_comments">true</property>

        <!-- Schema management -->
        <property name="hibernate.hbm2ddl.auto">none</property>

        <!-- Second-level cache -->
        <property name="hibernate.cache.use_second_level_cache">false</property>

        <!-- Mapping files -->
        <mapping resource="orm/Facility.hbm.xml"/>
    </session-factory>
</hibernate-configuration>
