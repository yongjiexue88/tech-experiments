<?xml version="1.0" encoding="UTF-8"?>
<!--
    Hibernate XML Mapping (HBM) for Facility entity.
    Demonstrates the traditional XML-based ORM approach used in many
    legacy ColdFusion + Java applications at TCEQ.

    NOTE: In this project, the actual ORM is handled by JPA annotations
    on the entity class. This file is included as a portfolio reference
    showing proficiency with XML-based Hibernate mappings.
-->
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.tceq.compliance.model">

    <class name="Facility" table="FACILITIES">

        <!-- Primary key with Oracle sequence generator -->
        <id name="id" column="ID" type="long">
            <generator class="sequence">
                <param name="sequence_name">FACILITY_SEQ</param>
            </generator>
        </id>

        <!-- Simple properties -->
        <property name="facilityName" column="FACILITY_NAME" type="string"
                  not-null="true" length="200"/>
        <property name="epaId" column="EPA_ID" type="string"
                  not-null="true" unique="true" length="20"/>
        <property name="facilityType" column="FACILITY_TYPE" type="string"
                  length="50"/>
        <property name="address" column="ADDRESS" type="string"
                  length="300"/>
        <property name="city" column="CITY" type="string"
                  length="100"/>
        <property name="county" column="COUNTY" type="string"
                  length="100"/>
        <property name="stateCode" column="STATE_CODE" type="string"
                  length="2"/>
        <property name="zipCode" column="ZIP_CODE" type="string"
                  length="10"/>
        <property name="latitude" column="LATITUDE" type="double"/>
        <property name="longitude" column="LONGITUDE" type="double"/>
        <property name="status" column="STATUS" type="string"
                  length="20"/>
        <property name="registrationDate" column="REGISTRATION_DATE" type="java.time.LocalDate"/>

        <!-- One-to-many: Facility → Permits -->
        <bag name="permits" inverse="true" cascade="all-delete-orphan"
             lazy="true" fetch="select">
            <key column="FACILITY_ID"/>
            <one-to-many class="Permit"/>
        </bag>

        <!-- One-to-many: Facility → Inspections -->
        <bag name="inspections" inverse="true" cascade="all-delete-orphan"
             lazy="true" fetch="select">
            <key column="FACILITY_ID"/>
            <one-to-many class="Inspection"/>
        </bag>

        <!-- One-to-many: Facility → Violations -->
        <bag name="violations" inverse="true" cascade="all-delete-orphan"
             lazy="true" fetch="select">
            <key column="FACILITY_ID"/>
            <one-to-many class="Violation"/>
        </bag>

    </class>

</hibernate-mapping>
