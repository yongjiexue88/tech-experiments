<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.interview.hibernate</groupId>
    <artifactId>hibernate-sqlite-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Spring Boot Data JPA + SQLite Demo</name>
    <description>
        独立 Spring Boot 项目，使用 SQLite 作为本地数据库。
        展示自动配置的 SessionFactory 生命周期、声明式事务管理 (@Transactional) 
        以及 Spring Data JPA Repository 模式，适用于高级 Java 面试准备。
    </description>

    <properties>
        <java.version>17</java.version>
        <!-- properties for things not implicitly managed by spring-boot-starter-parent -->
        <sqlite.jdbc.version>3.45.1.0</sqlite.jdbc.version>
        <hibernate.community.version>6.4.4.Final</hibernate.community.version>
    </properties>

    <dependencies>
        <!-- 
           Spring Boot Data JPA - 这个起步依赖自动包含了 Hibernate Core, 
           HikariCP 数据库连接池, 和 Spring 的 @Transactional 支持。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            COMMUNITY DIALECTS — Hibernate 依然需要方言解析器
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate.community.version}</version>
        </dependency>

        <!-- SQLite 的 Java 驱动 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
        </dependency>

        <!-- 
           Spring Boot Starter Test - 自动包含 JUnit 5 (Jupiter), AssertJ, Mockito 等
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 替换掉 compiler plugin 为 spring-boot-maven-plugin，实现可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
