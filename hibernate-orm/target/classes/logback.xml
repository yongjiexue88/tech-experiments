<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback 日志配置文件 — 控制日志的输出格式和级别 -->
<configuration>
    <!-- 定义一个名为 STDOUT 的输出器，将日志打印到控制台 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                日志输出格式:
                %d{HH:mm:ss.SSS} → 时间 (时:分:秒.毫秒)
                [%thread]        → 线程名
                %-5level         → 日志级别 (左对齐，占5个字符)
                %logger{36}      → 日志记录器名 (最多36个字符)
                %msg             → 日志消息内容
                %n               → 换行符
            -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hibernate SQL 日志 — 显示生成的 SQL 语句 -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <!-- Hibernate 绑定参数日志 — 显示 SQL 中 ? 占位符的实际值 -->
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

    <!-- 根日志级别设为 INFO，使用 STDOUT 输出器 -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
